{
  "id": "auto-heat-and-cool-seats",
  "name": "자동 열선·통풍 시트 (Auto Heat and Cool Seats)",
  "version": "1.1.1",
  "hmgapi": ">=1.0.0",
  "authors": ["Kyle", "Skystory"],
  "license": "AGPL-3.0",
  "description": "시동을 걸면 외기온도를 확인해, 추위 기준 이하이면 고른 시트 열선과 핸들 열선을, 더위 기준 이상이면 고른 통풍 시트를 켭니다. 이미 켜 둔 좌석은 건드리지 않습니다. 기본 단위는 섭씨입니다. eclipseempire의 Cold-start Heat를 바탕으로 한 HMG-API 모드의 섭씨·한글화 버전입니다.",
  "live": true,
  "services": [
    { "name": "seats", "script": "seats.sh", "user": "system", "restart": true, "start": "android" }
  ],
  "vehicle": {
    "read": [
      "hv.ready", "moving", "outside_temp", "outside_temp_f", "wheel_heat",
      "seat_state.driver", "seat_state.passenger", "seat_state.rear_left", "seat_state.rear_right"
    ],
    "commands": ["seat_heat", "seat_vent", "wheel_heat"]
  }
}
